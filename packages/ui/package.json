{
  "name": "@blog/ui",
  "version": "1.0.0",
  "description": "blog ui components",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && copyfiles -u 1 \"src/**/*.css\" dist",
    "start": "tsc && node dist/index.js"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1"
  }
}
